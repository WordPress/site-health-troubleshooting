{
  "author": "The WordPress Community",
  "bugs": {
    "url": "https://github.com/WordPress/troubleshooting/issues"
  },
  "description": "Introduces additional common tools to the Site Health interface.",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@wordpress/dependency-extraction-webpack-plugin": "^7.1.0",
    "@wordpress/env": "^12.1.0",
    "@wordpress/scripts": "^37.1.0",
    "@wordpress/stylelint-config": "^27.1.0",
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "GPL-2.0+",
  "name": "troubleshooting",
  "version": "1.0.0",
  "scripts": {
    "build": "wp-scripts build",
    "lint": "npm-run-all lint:css lint:js",
    "lint:css": "wp-scripts lint-style './src/styles/**/*.scss'",
    "lint:js": "wp-scripts lint-js './src/**/*.js'",
    "lint:php": "wp-env run --env-cwd='wp-content/plugins/site-health-troubleshooting' cli composer run-script lint",
    "test": "npm-run-all lint test:e2e",
    "test:e2e": "wp-scripts test-playwright --config ./tests/e2e.config.ts",
    "test:e2e-report": "playwright show-report",
    "test:e2e:debug": "wp-scripts test-playwright --config ./tests/e2e.config.ts --ui",
    "test:e2e:watch": "npm run test:e2e -- --watch",
    "test:php": "npm-run-all lint:php test:unit:php",
    "test:php:watch": "wp-env run --env-cwd='wp-content/plugins/site-health-troubleshooting' tests-cli composer run-script test:watch",
    "test:unit:php:base": "wp-env run --env-cwd='wp-content/plugins/site-health-troubleshooting' tests-wordpress vendor/bin/phpunit -c phpunit.xml.dist --verbose",
    "test:unit:php": "npm-run-all test:unit:php:base",
    "start": "wp-scripts start",
    "wp-env": "wp-env",
    "plugin-zip": "wp-scripts plugin-zip"
  },
  "stylelint": {
    "extends": "@wordpress/stylelint-config",
    "rules": {
      "no-descending-specificity": null,
      "at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": [
            "use"
          ]
        }
      ]
    }
  },
  "files": [
    "troubleshooting.php",
    "build/**",
    "Troubleshooting/**",
    "mu-plugins/**",
    "templates/**",
    "uninstall.php",
    "changelog.txt",
    "readme.txt"
  ]
}
